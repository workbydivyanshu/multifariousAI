# ============================================
# MULTIFARIOUSAI - ENVIRONMENT VARIABLES
# ============================================

# ============================================
# FREE MODELS (No Key Required!)
# ============================================
# You can use the following models WITHOUT any API key:
# - DeepSeek R1 (Free)
# - Llama 3.3 70B (Free)
# - Qwen 2.5 72B (Free)
# - Mistral Small 24B (Free)
# - Gemma 3 27B (Free)
# - GLM 4.5 Air (Free)
# - And 20+ more free models!
#
# Just skip to step 3 and start chatting!

# ============================================
# CLOUD API KEYS (Optional - for Premium Models)
# ============================================

# OpenRouter API Key (Optional)
# Required for: Claude 3.5, GPT-4o, GPT-4o Mini, and 100+ premium models
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (Optional)
# Required for: Gemini 2.0 Flash, Gemini 1.5 Pro
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral API Key (Optional)
# Required for: Mistral Large, Codestral, Pixtral
# Get your key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================
# LOCAL AI (Ollama - Optional)
# ============================================

# Ollama Base URL
# Default is localhost:11434
# Install Ollama from: https://ollama.ai
OLLAMA_URL=http://localhost:11434

# ============================================
# DATABASE (Required for Authentication & Chat Persistence)
# ============================================

# PostgreSQL Database URL
# Required for user authentication and chat history
# Example: postgresql://username:password@localhost:5432/multifariousai
DATABASE_URL="postgresql://username:password@localhost:5432/multifariousai"

# ============================================
# OAUTH PROVIDERS (Required for Authentication)
# ============================================

# GitHub OAuth
# Get from: https://github.com/settings/applications/new
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ============================================
# RATE LIMITING (Optional)
# ============================================

# Maximum output tokens per request (default: 10000)
MAX_OUTPUT_TOKENS=10000

# Rate limit window in milliseconds (default: 86400000 = 24 hours)
RATE_LIMIT_WINDOW=86400000

# ============================================
# DEVELOPMENT
# ============================================

# Enable debug logging
DEBUG=false

# Debug Ollama requests
DEBUG_OLLAMA=false
