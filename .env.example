# ============================================
# MULTIFARIOUSAI - ENVIRONMENT VARIABLES
# ============================================

# ============================================
# FREE MODELS (No Key Required!)
# ============================================
# You can use the following models WITHOUT any API key:
# - DeepSeek R1 (Free)
# - Llama 3.3 70B (Free)
# - Qwen 2.5 72B (Free)
# - Mistral Small 24B (Free)
# - Gemma 3 27B (Free)
# - GLM 4.5 Air (Free)
# - And 20+ more free models!
#
# Just skip to step 3 and start chatting!

# ============================================
# CLOUD API KEYS (Optional - for Premium Models)
# ============================================

# OpenRouter API Key (Optional)
# Required for: Claude 3.5, GPT-4o, GPT-4o Mini, and 100+ premium models
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (Optional)
# Required for: Gemini 2.0 Flash, Gemini 1.5 Pro
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral API Key (Optional)
# Required for: Mistral Large, Codestral, Pixtral
# Get your key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================
# LOCAL AI (Ollama - Optional)
# ============================================

# Ollama Base URL
# Default is localhost:11434
# Install Ollama from: https://ollama.ai
OLLAMA_URL=http://localhost:11434

# ============================================
# DATABASE (Optional - for cloud sync)
# ============================================

# Supabase URL (Optional)
# For authentication and chat persistence
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Supabase Anon Key (Optional)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# AUTH (Optional)
# ============================================

# Bypass authentication for local development
NEXT_PUBLIC_BYPASS_AUTH=1

# ============================================
# RATE LIMITING (Optional)
# ============================================

# Maximum output tokens per request (default: 10000)
MAX_OUTPUT_TOKENS=10000

# Rate limit window in milliseconds (default: 86400000 = 24 hours)
RATE_LIMIT_WINDOW=86400000

# ============================================
# DEVELOPMENT
# ============================================

# Enable debug logging
DEBUG=false

# Debug Ollama requests
DEBUG_OLLAMA=false
