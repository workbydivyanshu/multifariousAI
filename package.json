{
  "name": "multifariousai",
  "version": "0.2.0",
  "description": "Multimodel AI chat with desktop packaging for Windows",
  "author": "MultifariousAI Team",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
